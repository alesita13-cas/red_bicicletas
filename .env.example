# Copiá este archivo como ".env" para desarrollo local y completá tus valores.
# En Heroku, estas mismas variables se configuran como "Config Vars" (no en un archivo).

# --- Entorno ---
NODE_ENV=development

# --- JWT y sesión ---
JWT_SECRET=unaClaveSecretaBienLargaYDificilDeAdivinar
SESSION_SECRET=otraClaveSecretaParaLaSesion

# --- Mongo Atlas (solo se usa si NODE_ENV=production) ---
MONGO_URI=mongodb+srv://usuario:password@tu-cluster.mongodb.net/red_bicicletas

# --- URL pública de la app (para armar los links de los emails) ---
APP_URL=http://localhost:3000

# --- Email en desarrollo: Ethereal ---
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=tu_usuario_de_prueba
EMAIL_PASS=tu_password_de_prueba

# --- Email en producción: SendGrid ---
SENDGRID_API_KEY=tu_api_key_de_sendgrid

# --- Login con Google ---
GOOGLE_CLIENT_ID=tu_client_id_de_google
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google
GOOGLE_CALLBACK_URL=/auth/google/callback

# --- Login con Facebook ---
FACEBOOK_APP_ID=tu_app_id_de_facebook
FACEBOOK_APP_SECRET=tu_app_secret_de_facebook

# --- New Relic ---
NEW_RELIC_LICENSE_KEY=tu_license_key_de_new_relic
