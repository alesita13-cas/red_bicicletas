<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Bicicletas - Red de Bicicletas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark px-4">
        <span class="navbar-brand">🚲 Red de Bicicletas</span>
        <div class="text-white">
            <%= usuario.email %> — <a href="/logout" class="text-warning">Salir</a>
        </div>
    </nav>

    <div class="container mt-4">
        <h2>Bicicletas registradas</h2>
        <table class="table table-striped bg-white">
            <thead>
                <tr><th>Code</th><th>Color</th><th>Modelo</th><th>Ubicación</th></tr>
            </thead>
            <tbody>
                <% bicicletas.forEach(function (b) { %>
                    <tr>
                        <td><%= b.code %></td>
                        <td><%= b.color %></td>
                        <td><%= b.modelo %></td>
                        <td><%= b.ubicacion %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>
